# Example only. Never commit real ETAPI tokens.
TRILIUI_BIND=127.0.0.1
TRILIUI_PORT=8787

# Trilium server URL as reached from the TriliUI server
TRILIUM_BASE_URL=http://127.0.0.1:8080
TRILIUM_ETAPI_TOKEN=REPLACE_WITH_YOUR_TRILIUM_ETAPI_TOKEN

# "root" for all notes or specify a note ID to scope the tree.
TRILIUI_ROOT_NOTE_ID=root

# Optional: HTTPS browser-streaming service URL, accessible from Android.
# Must use a distinct protected origin; do not expose an unprotected remote desktop.
# TRILIUI_REMOTE_BROWSER_URL=https://browser.example.ts.net/

# Optional: native Trilium web URL (reserved for future integration).
# TRILIUM_WEB_URL=https://trilium.example.ts.net/
